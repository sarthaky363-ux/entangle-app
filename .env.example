# Optional. Used server-side by the Vite development API plugin and Express server.
# Leave empty to use deterministic/fixed local fallbacks. Put a real key only in .env.
GEMINI_API_KEY=

# Optional. Express production server port (server.ts); default is 3000.
PORT=3000

# Optional. Set to "true" to disable Vite HMR and its file watcher.
DISABLE_HMR=false
